output_item: output_item = ResponseCodeInterpreterToolCall(id='ci_03dd42036a8f1ed70069b2a881165c8197a6a0380f7fda3f1e', code='reports["GlobalWarning.spec.js"]=long_report(\n    "Unit tests for GlobalWarning component rendering and accessibility semantics.",\n    "src/__tests__/GlobalWarning.spec.js",\n    code_map["GlobalWarning.spec.js"],\n    findings=[\n        dict(\n            title="Testing-library best practice: prefer `getBy*` for positive assertions",\n            severity="LOW",\n            category="Test quality",\n            location="src/__tests__/GlobalWarning.spec.js: multiple tests use `queryByTestId` then `toBeTruthy()`",\n            issue="Using `queryByTestId` + truthy assertions is less precise and can hide failures (e.g., element exists but is empty).",\n            why="More precise assertions reduce false positives and improve debuggability.",\n            rec="Use `getByTestId` for expected presence and `queryByTestId` for expected absence; assert on `toBeInTheDocument()` if jest-dom is available."\n        ),\n        dict(\n            title="Redundant duplication between R3 and R4 suites; consider parameterized tests",\n            severity="LOW",\n            category="Maintainability",\n            location="src/__tests__/GlobalWarning.spec.js",\n            issue="R3 and R4 tests repeat the same structure with different message constants.",\n            why="Duplication increases maintenance cost if component markup changes.",\n            rec="Use `describe.each` / `it.each` over `[warningMessage, label]` tuples to test both warning types with shared expectations."\n        ),\n        dict(\n            title="Accessibility test checks `role` attribute but not live region behavior",\n            severity="INFO",\n            category="Accessibility, Test completeness",\n            location="src/__tests__/GlobalWarning.spec.js: role=\\"alert\\" test",\n            issue="The test verifies role only; it doesn\'t ensure there isn\'t conflicting `aria-live` semantics.",\n            why="AT behavior can\'t be fully tested unit-wise, but you can still assert consistent attribute combinations (e.g., role/status).",\n            rec="If you change to `role=\\"status\\"` or remove `aria-live`, update tests to reflect chosen contract."\n        ),\n        dict(\n            title="Mock hygiene: `useSelectedProjectValue` is mocked but unused",\n            severity="INFO",\n            category="Test cleanliness",\n            location="src/__tests__/GlobalWarning.spec.js: jest.mock(\'../context\', ... useSelectedProjectValue)",\n            issue="Mocking unused exports adds noise.",\n            why="Noise in tests reduces signal and can mask missing imports.",\n            rec="Only mock what you need, or centralize context mocks in a helper."\n        ),\n    ]\n)\npath=write_report("GlobalWarning.spec.js", reports["GlobalWarning.spec.js"])\npath\n', container_id='cntr_69b2a7fe810c81909a05b70d20c929c505b8e4e37121fe72', outputs=None, status='completed', type='code_interpreter_call')

